{
  "tasks": {
    "dev": "deno run --allow-all scripts/dev.ts",
    "dev:marketing": "deno run --allow-all scripts/dev-marketing.ts",
    "dev:blog": "deno run --allow-all scripts/dev-blog.ts",
    "dev:storefront": "deno run --allow-all scripts/dev-storefront.ts",
    "dev:docs": "deno run --allow-all scripts/dev-docs.ts",
    "build": "deno run --allow-all scripts/build.ts",
    "build:marketing": "deno run --allow-all scripts/build-marketing.ts",
    "build:blog": "deno run --allow-all scripts/build-blog.ts",
    "build:storefront": "deno run --allow-all scripts/build-storefront.ts",
    "build:docs": "deno run --allow-all scripts/build-docs.ts",
    "preview": "deno run --allow-all scripts/preview.ts",
    "preview:marketing": "deno run --allow-all scripts/preview-marketing.ts",
    "preview:blog": "deno run --allow-all scripts/preview-blog.ts",
    "preview:storefront": "deno run --allow-all scripts/preview-storefront.ts",
    "preview:docs": "deno run --allow-all scripts/preview-docs.ts",
    "start": "deno run --allow-net --allow-read server.ts",
    "test": "deno test --allow-all --no-check tests/",
    "test:solidstack": "deno test --allow-all --no-check tests/solidstack/",
    "test:solidstack:demos": "deno test --allow-all --no-check tests/solidstack/demo-components.test.ts",
    "test:solidstack:performance": "deno run --allow-all tests/solidstack/render-component.ts",
    "test:solidstack:accessibility": "deno run --allow-all tests/solidstack/accessibility-check.ts",
    "test:solidstack:all": "deno task test:solidstack:demos && deno task test:solidstack:accessibility",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "generate:panda": "deno run --allow-read --allow-write --allow-env npm:@pandacss/dev"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "imports": {
    "std/": "https://deno.land/std@0.140.0/",
    "std/assert/": "https://deno.land/std@0.140.0/assert/",
    "std/testing/": "https://deno.land/std@0.140.0/testing/",
    "h3": "npm:h3@1.10.1",
    "nitropack": "npm:nitropack@2.8.1",
    "@tanstack/solid-router": "npm:@tanstack/solid-router@^1.0.0",
    "@tanstack/solid-query": "npm:@tanstack/solid-query@^5.0.0",
    "@tanstack/solid-table": "npm:@tanstack/solid-table@^8.0.0",
    "@tanstack/solid-form": "npm:@tanstack/solid-form@^0.20.0",
    "@tanstack/solid-virtual": "npm:@tanstack/solid-virtual@^3.0.0",
    "@tanstack/solid-store": "npm:@tanstack/solid-store@^0.5.0",
    "@zag-js/solid": "npm:@zag-js/solid@^0.32.0",
    "@zag-js/accordion": "npm:@zag-js/accordion@^0.32.0",
    "@zag-js/checkbox": "npm:@zag-js/checkbox@^0.32.0",
    "@zag-js/dialog": "npm:@zag-js/dialog@^0.32.0",
    "@zag-js/menu": "npm:@zag-js/menu@^0.32.0",
    "@zag-js/number-input": "npm:@zag-js/number-input@^0.32.0",
    "@zag-js/popover": "npm:@zag-js/popover@^0.32.0",
    "@zag-js/radio-group": "npm:@zag-js/radio-group@^0.32.0",
    "@zag-js/select": "npm:@zag-js/select@^0.32.0",
    "@zag-js/slider": "npm:@zag-js/slider@^0.32.0",
    "@zag-js/switch": "npm:@zag-js/switch@^0.32.0",
    "@zag-js/tabs": "npm:@zag-js/tabs@^0.32.0",
    "@zag-js/tags-input": "npm:@zag-js/tags-input@^0.32.0",
    "@zag-js/toast": "npm:@zag-js/toast@^0.32.0",
    "@zag-js/toggle-group": "npm:@zag-js/toggle-group@^0.32.0",
    "@zag-js/tooltip": "npm:@zag-js/tooltip@^0.32.0",
    "clsx": "npm:clsx@^1.2.0",
    "tailwind-merge": "npm:tailwind-merge@^1.14.0",
    "framer-motion": "npm:framer-motion@^10.16.0",
    "lucide-solid": "npm:lucide-solid@^0.294.0",
    "@solid-primitives/utils": "npm:@solid-primitives/utils@^6.2.0",
    "@solid-primitives/event-listener": "npm:@solid-primitives/event-listener@^2.2.0",
    "solid-js": "npm:solid-js@^1.8.0",
    "zustand": "npm:zustand@4.4.1",
    "@sse/ui": "./libs/ui/src/index.ts",
    "@sse/utils": "./libs/utils/src/index.ts",
    "@sse/types": "./libs/types/src/index.ts"
  },
  "lint": {
    "files": {
      "include": ["apps/", "libs/", "scripts/", "tests/", "infrastructure/"],
      "exclude": ["node_modules/", "dist/", ".solid/", "libs/ui/src/styled-system/"]
    }
  },
  "fmt": {
    "files": {
      "include": ["apps/", "libs/", "scripts/", "tests/", "infrastructure/"],
      "exclude": ["node_modules/", "dist/", ".solid/", "libs/ui/src/styled-system/"]
    }
  }
}