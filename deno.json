{
  "name": "@katalyst-react/framework",
  "version": "0.1.0",
  "exports": {
    ".": "./shared/src/index.ts",
    "./core": "./core/src/main.tsx",
    "./remix": "./remix/app/root.tsx",
    "./next": "./next/src/app/page.tsx",
    "./shared": "./shared/src/index.ts"
  },
  "tasks": {
    "dev": "deno run --allow-all scripts/unified-runner.ts --task dev",
    "dev:core": "deno run --allow-all scripts/unified-runner.ts --task dev:core",
    "dev:remix": "deno run --allow-all scripts/unified-runner.ts --task dev:remix",
    "dev:nextjs": "deno run --allow-all scripts/unified-runner.ts --task dev:nextjs",
    "build": "deno run --allow-all scripts/unified-runner.ts --task build --cloud-cache",
    "build:core": "deno run --allow-all scripts/unified-runner.ts --task build --frameworks core",
    "build:remix": "deno run --allow-all scripts/unified-runner.ts --task build --frameworks remix",
    "build:nextjs": "deno run --allow-all scripts/unified-runner.ts --task build --frameworks nextjs",
    "build:web": "deno run --allow-all scripts/unified-runner.ts --task build:web --platforms web",
    "build:desktop": "deno run --allow-all scripts/unified-runner.ts --task build:desktop --platforms desktop",
    "build:mobile": "deno run --allow-all scripts/unified-runner.ts --task build:mobile --platforms mobile",
    "build-native": "deno run --allow-all scripts/unified-runner.ts --task build-native",
    "test": "deno run --allow-all tests/run-all.ts",
    "test:unit": "deno run --allow-all tests/run-all.ts --mode unit",
    "test:integration": "deno run --allow-all tests/run-all.ts --mode integration",
    "test:performance": "deno run --allow-all tests/run-all.ts --mode performance",
    "test:e2e": "deno run --allow-all tests/run-all.ts --mode e2e",
    "test:shared": "deno run --allow-all tests/run-all.ts --frameworks shared",
    "test:core": "deno run --allow-all tests/run-all.ts --frameworks core",
    "test:remix": "deno run --allow-all tests/run-all.ts --frameworks remix",
    "test:nextjs": "deno run --allow-all tests/run-all.ts --frameworks nextjs",
    "test:coverage": "deno run --allow-all tests/run-all.ts --coverage --reporter html",
    "test:watch": "deno run --allow-all tests/run-all.ts --watch",
    "test:ci": "deno run --allow-all tests/run-all.ts --coverage --reporter junit --bail",
    "test:parallel": "deno run --allow-all tests/run-all.ts --parallel",
    "test:verbose": "deno run --allow-all tests/run-all.ts --verbose",
    "test:multithreading": "deno run --allow-all tests/performance/multithreading.test.ts",
    "test:wasm": "deno run --allow-all tests/performance/webassembly.test.ts",
    "test:cross-framework": "deno run --allow-all tests/integration/cross-framework.test.ts",
    "test:user-journey": "deno run --allow-all tests/e2e/user-journey.test.ts",
    "test:setup": "deno run --allow-all -c deno.test.config.ts tests/setup.ts",
    "test:clean": "rm -rf tests/output tests/coverage .nyc_output",
    "lint": "deno run --allow-all scripts/unified-runner.ts --task lint",
    "lint:deno": "deno lint && deno fmt --check",
    "typecheck": "deno run --allow-all scripts/unified-runner.ts --task typecheck",
    "typecheck:deno": "deno check **/*.ts",
    "preview": "deno run --allow-all scripts/unified-runner.ts --task preview",
    "preview:core": "deno run --allow-all scripts/unified-runner.ts --task preview --frameworks core",
    "preview:remix": "deno run --allow-all scripts/unified-runner.ts --task preview --frameworks remix",
    "preview:nextjs": "deno run --allow-all scripts/unified-runner.ts --task preview --frameworks nextjs",
    "clean": "deno run --allow-all scripts/unified-runner.ts --clean",
    "clean:all": "rm -rf dist .next .remix node_modules/.cache .turbo .nx coverage tests/output",
    "install": "deno run --allow-all scripts/unified-runner.ts --install",
    "install:fallback": "bun install",
    "cache:setup": "deno run --allow-all scripts/unified-runner.ts --cloud-cache",
    "status": "deno run --allow-all scripts/unified-runner.ts --status",
    "unified": "deno run --allow-all scripts/unified-runner.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy": "deno run --allow-all scripts/unified-runner.ts --task deploy",
    "nx:run": "nx",
    "turbo:run": "turbo",
    "bun:run": "bun"
  },
  "imports": {
    "@/": "./shared/src/",
    "@shared/": "./shared/src/",
    "@katalyst-react/shared": "./shared/src/index.ts",
    "@katalyst-react/core": "./core/src/main.tsx",
    "@katalyst-react/remix": "./remix/app/root.tsx",
    "@katalyst-react/next": "./next/src/app/page.tsx",
    "react": "npm:react@^19.0.0",
    "react-dom": "npm:react-dom@^19.0.0",
    "@tanstack/react-router": "npm:@tanstack/react-router@^1.120.17",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.59.20",
    "@tanstack/react-form": "npm:@tanstack/react-form@^0.34.1",
    "@tanstack/react-table": "npm:@tanstack/react-table@^8.20.5",
    "@tanstack/react-virtual": "npm:@tanstack/react-virtual@^3.10.8",
    "zustand": "npm:zustand@^5.0.2",
    "@clerk/clerk-react": "npm:@clerk/clerk-react@^5.17.0",
    "tailwindcss": "npm:tailwindcss@^4.0.0",
    "@arco-design/web-react": "npm:@arco-design/web-react@^2.63.2",
    "react-cosmos": "npm:react-cosmos@^6.2.0",
    "typia": "npm:typia@^6.11.3",
    "nx": "npm:nx@^21.2.2",
    "turbo": "npm:turbo@^1.10.0",
    "@biomejs/biome": "npm:@biomejs/biome@^1.9.4"
  },
  "compilerOptions": {
    "allowJs": true,
    "lib": ["dom", "dom.iterable", "es6", "deno.ns"],
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "target": "es2022",
    "useDefineForClassFields": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true
  },
  "unstable": ["sloppy-imports", "byonm"],
  "nodeModulesDir": "auto",
  "lock": false,
  "workspace": ["./core", "./remix", "./next", "./shared"]
}
