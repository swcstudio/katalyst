{
  "tasks": {
    "dev": "deno run --allow-all scripts/dev.ts",
    "dev:marketing": "deno run --allow-all scripts/dev-marketing.ts",
    "dev:blog": "deno run --allow-all scripts/dev-blog.ts",
    "dev:storefront": "deno run --allow-all scripts/dev-storefront.ts",
    "dev:docs": "deno run --allow-all scripts/dev-docs.ts",
    "dev:remix": "deno run --allow-all scripts/dev-remix.ts",
    "dev:sveltekit": "deno run --allow-all scripts/dev-sveltekit.ts",
    "build": "deno run --allow-all scripts/build.ts",
    "build:marketing": "deno run --allow-all scripts/build-marketing.ts",
    "build:blog": "deno run --allow-all scripts/build-blog.ts",
    "build:storefront": "deno run --allow-all scripts/build-storefront.ts",
    "build:docs": "deno run --allow-all scripts/build-docs.ts",
    "build:remix": "deno run --allow-all scripts/build-remix.ts",
    "build:sveltekit": "deno run --allow-all scripts/build-sveltekit.ts",
    "preview": "deno run --allow-all scripts/preview.ts",
    "preview:marketing": "deno run --allow-all scripts/preview-marketing.ts",
    "preview:blog": "deno run --allow-all scripts/preview-blog.ts",
    "preview:storefront": "deno run --allow-all scripts/preview-storefront.ts",
    "preview:docs": "deno run --allow-all scripts/preview-docs.ts",
    "preview:remix": "deno run --allow-all scripts/preview-remix.ts",
    "preview:sveltekit": "deno run --allow-all scripts/preview-sveltekit.ts",
    "start": "deno run --allow-net --allow-read server.ts",
    "test": "deno run --allow-all scripts/test-all.ts",
    "test:unit": "deno test --allow-all --no-check tests/",
    "test:frameworks": "deno run --allow-all npm:rstest",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "biome": "deno run --allow-read --allow-write npm:@biomejs/biome check .",
    "biome:fix": "deno run --allow-read --allow-write npm:@biomejs/biome check --apply .",

    "generate:panda": "deno run --allow-read --allow-write --allow-env npm:@pandacss/dev",
    "rsdoctor": "deno run --allow-all npm:@rsdoctor/core --port 20007"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "imports": {
    "std/": "https://deno.land/std@0.140.0/",
    "std/assert/": "https://deno.land/std@0.140.0/assert/",
    "std/testing/": "https://deno.land/std@0.140.0/testing/",
    "h3": "npm:h3@1.10.1",
    "nitropack": "npm:nitropack@2.8.1",
    "@tanstack/solid-router": "npm:@tanstack/solid-router@1.120.17",
    "@tanstack/solid-query": "npm:@tanstack/solid-query@5.17.1",
    "@tanstack/solid-table": "npm:@tanstack/solid-table@8.11.6",
    "@tanstack/solid-form": "npm:@tanstack/solid-form@0.19.4",
    "@tanstack/solid-virtual": "npm:@tanstack/solid-virtual@3.0.1",
    "@tanstack/solid-store": "npm:@tanstack/solid-store@0.5.0",
    "@tanstack/solid-pacer": "npm:@tanstack/solid-pacer@0.2.0",
    "@zag-js/solid": "npm:@zag-js/solid@0.32.1",
    "@park-ui/panda-preset": "npm:@park-ui/panda-preset@0.33.0",
    "solid-js": "npm:solid-js@1.9.7",
    "zustand": "npm:zustand@4.4.7",
    "@rsbuild/core": "npm:@rsbuild/core@1.0.1",
    "@rsbuild/plugin-solid": "npm:@rsbuild/plugin-solid@1.0.1",
    "@pandacss/dev": "npm:@pandacss/dev@0.45.2",
    "@rslib/core": "npm:@rslib/core@0.0.5",
    "animejs": "npm:animejs@3.2.2",
    "@types/animejs": "npm:@types/animejs@3.1.12",
    "@biomejs/biome": "npm:@biomejs/biome@1.8.3",

    "@remix-run/node": "npm:@remix-run/node@2.12.1",
    "@remix-run/react": "npm:@remix-run/react@2.12.1",
    "@remix-run/serve": "npm:@remix-run/serve@2.12.1",
    "@remix-run/dev": "npm:@remix-run/dev@2.12.1",
    "react": "npm:react@18.3.1",
    "react-dom": "npm:react-dom@18.3.1",
    "@types/react": "npm:@types/react@18.3.5",
    "@types/react-dom": "npm:@types/react-dom@18.3.0",
    "@sveltejs/kit": "npm:@sveltejs/kit@2.5.28",
    "@sveltejs/adapter-static": "npm:@sveltejs/adapter-static@3.0.4",
    "svelte": "npm:svelte@4.2.19",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@3.1.2",
    "svelte-check": "npm:svelte-check@3.8.6",
    "@rsbuild/plugin-svelte": "npm:@rsbuild/plugin-svelte@1.0.1",
    "typescript": "npm:typescript@5.6.2",
    "~/": "./src/"
  },
  "lint": {
    "files": {
      "include": ["src/", "scripts/", "tests/", "apps/", "libs/"],
      "exclude": ["node_modules/", "dist/", ".solid/", "src/styled-system/", "**/.svelte-kit/"]
    }
  },
  "fmt": {
    "files": {
      "include": ["src/", "scripts/", "tests/", "apps/", "libs/"],
      "exclude": ["node_modules/", "dist/", ".solid/", "src/styled-system/", "**/.svelte-kit/"]
    }
  }
}
