{
  "name": "sota-marketing-stack",
  "version": "1.0.0",
  "description": "A state-of-the-art, cloud-native, distributed system boilerplate for marketing websites",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "prepare": "husky install",
    "docs": "rspress dev",
    "docs:build": "rspress build",
    "docs:preview": "rspress preview"
  },
  "dependencies": {
    "@clerk/clerk-js": "^4.50.0",
    "@park-ui/panda-preset": "^0.20.0",
    "@tanstack/solid-query": "^4.29.1",
    "@tanstack/solid-table": "^8.10.0",
    "@tanstack/solid-virtual": "^3.0.0",
    "@tanstack/solid-store": "^0.2.0",
    "convex": "^1.0.0",
    "date-fns": "^2.30.0",
    "solid-js": "^1.7.11",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@pandacss/dev": "^0.15.0",
    "@rsbuild/core": "^0.2.0",
    "@rsbuild/plugin-solid": "^0.2.0",
    "@rslib/core": "^0.1.0",
    "@rspack/cli": "^0.3.0",
    "@rspress/core": "^1.0.0",
    "@rsdoctor/core": "^0.1.0",
    "@solid-primitives/i18n": "^2.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-solid": "^0.13.0",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "lint-staged": "^14.0.0",
    "prettier": "^3.0.0",
    "solid-testing-library": "^0.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,md,json}": [
      "prettier --write"
    ]
  },
  "author": "Spectrum Web Co LLC",
  "license": "MIT"
}
