{
  "name": "katalyst-react",
  "version": "1.0.0",
  "description": "Spectrum Web Co AIO Management System - Complete frontend solution for marketing, blog, NFT storefront, email management, admin dashboard, and content management",
  "keywords": [
    "react",
    "react19",
    "framework",
    "micro-frontend",
    "rspack",
    "tanstack",
    "typescript",
    "tailwindcss",
    "biome",
    "nx",
    "storybook",
    "web3",
    "ai",
    "performance"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/swcstudio/katalyst.git"
  },
  "license": "Apache-2.0",
  "author": "SomeRandmGuyy",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./shared/src/index.ts",
    "./core": "./core/src/main.tsx",
    "./remix": "./remix/app/root.tsx",
    "./next": "./next/src/app/page.tsx",
    "./shared": "./shared/src/index.ts"
  },
  "main": "./shared/src/index.ts",
  "bin": {
    "katalyst-scraper": "./shared/src/scraper/bin/katalyst-scraper.ts"
  },
  "workspaces": ["core", "remix", "next", "shared"],
  "scripts": {
    "build": "deno run --allow-all scripts/unified-runner.ts --task build --cloud-cache",
    "build-native": "deno run --allow-all scripts/unified-runner.ts --task build-native",
    "build-storybook": "storybook build",
    "build:all": "turbo build:all-platforms",
    "build:desktop": "deno run --allow-all scripts/unified-runner.ts --task build:desktop --platforms desktop",
    "build:mobile": "deno run --allow-all scripts/unified-runner.ts --task build:mobile --platforms mobile",
    "build:web": "deno run --allow-all scripts/unified-runner.ts --task build:web --platforms web",
    "bun:build": "bun run build",
    "bun:dev": "bun run dev",
    "bun:install": "bun install",
    "bun:test": "bun test",
    "cache:nx": "nx connect-to-nx-cloud",
    "cache:setup": "deno run --allow-all scripts/unified-runner.ts --cloud-cache",
    "cache:turbo": "turbo login",
    "clean": "deno run --allow-all scripts/unified-runner.ts --clean",
    "clean:all": "rm -rf dist .next .remix node_modules/.cache .turbo .nx coverage tests/output",
    "clean:nx": "nx reset && rm -rf dist .next .remix node_modules/.cache",
    "clean:turbo": "turbo prune && rm -rf dist .next .remix",
    "deno:check": "deno check **/*.ts",
    "deno:fmt": "deno fmt",
    "deno:lint": "deno lint",
    "deno:test": "deno test --allow-all",
    "deploy": "deno run --allow-all scripts/unified-runner.ts --task deploy",
    "deploy:desktop": "turbo build:desktop && deno run --allow-all scripts/unified-runner.ts --task deploy --platforms desktop",
    "deploy:mobile": "turbo build:mobile && deno run --allow-all scripts/unified-runner.ts --task deploy --platforms mobile",
    "deploy:web": "turbo build:web && deno run --allow-all scripts/unified-runner.ts --task deploy --platforms web",
    "dev": "deno run --allow-all scripts/unified-runner.ts --task dev",
    "dev:core": "deno run --allow-all scripts/unified-runner.ts --task dev:core",
    "dev:next": "deno run --allow-all scripts/unified-runner.ts --task dev:next",
    "dev:remix": "deno run --allow-all scripts/unified-runner.ts --task dev:remix",
    "install": "deno run --allow-all scripts/unified-runner.ts --install",
    "install:fallback": "bun install",
    "lint": "deno run --allow-all scripts/unified-runner.ts --task lint",
    "lint:bun": "bun run biome check .",
    "lint:nx": "nx run-many --target=lint --projects=core,remix,next,shared --parallel",
    "lint:turbo": "turbo lint",
    "nx:build": "nx run-many --target=build --projects=core,remix,next --parallel",
    "nx:dev": "nx run-many --target=dev --projects=core,remix,next --parallel",
    "nx:lint": "nx run-many --target=lint --projects=core,remix,next,shared --parallel",
    "nx:test": "nx run-many --target=test --projects=core,remix,next,shared --parallel",
    "preview": "deno run --allow-all scripts/unified-runner.ts --task preview",
    "preview:core": "deno run --allow-all scripts/unified-runner.ts --task preview --frameworks core",
    "preview:next": "deno run --allow-all scripts/unified-runner.ts --task preview --frameworks next",
    "preview:remix": "deno run --allow-all scripts/unified-runner.ts --task preview --frameworks remix",
    "status": "deno run --allow-all scripts/unified-runner.ts --status",
    "storybook": "storybook dev -p 6006",
    "test": "deno run --allow-all scripts/unified-runner.ts --task test",
    "test:ci": "deno run --allow-all tests/run-all.ts --coverage --reporter junit --bail",
    "test:clean": "rm -rf tests/output tests/coverage .nyc_output",
    "test:core": "deno run --allow-all scripts/unified-runner.ts --task test --frameworks core",
    "test:coverage": "deno run --allow-all tests/run-all.ts --coverage --reporter html",
    "test:cross-framework": "deno run --allow-all tests/integration/cross-framework.test.ts",
    "test:e2e": "deno run --allow-all scripts/unified-runner.ts --task test:e2e",
    "test:integration": "deno run --allow-all scripts/unified-runner.ts --task test:integration",
    "test:multithreading": "deno run --allow-all tests/performance/multithreading.test.ts",
    "test:next": "deno run --allow-all scripts/unified-runner.ts --task test --frameworks next",
    "test:parallel": "deno run --allow-all tests/run-all.ts --parallel",
    "test:performance": "deno run --allow-all scripts/unified-runner.ts --task test:performance",
    "test:remix": "deno run --allow-all scripts/unified-runner.ts --task test --frameworks remix",
    "test:setup": "deno run --allow-all -c deno.test.config.ts tests/setup.ts",
    "test:shared": "deno run --allow-all scripts/unified-runner.ts --task test --frameworks shared",
    "test:unit": "deno run --allow-all scripts/unified-runner.ts --task test:unit",
    "test:user-journey": "deno run --allow-all tests/e2e/user-journey.test.ts",
    "test:verbose": "deno run --allow-all tests/run-all.ts --verbose",
    "test:wasm": "deno run --allow-all tests/performance/webassembly.test.ts",
    "test:watch": "deno run --allow-all tests/run-all.ts --watch",
    "turbo:build": "turbo build",
    "turbo:dev": "turbo dev",
    "turbo:lint": "turbo lint",
    "turbo:test": "turbo test",
    "typecheck": "deno run --allow-all scripts/unified-runner.ts --task typecheck",
    "typecheck:nx": "nx run-many --target=typecheck --projects=core,remix,next,shared --parallel",
    "typecheck:turbo": "turbo check-types",
    "unified": "deno run --allow-all scripts/unified-runner.ts",
    "tauri:dev": "deno run --allow-all scripts/tauri-builder.ts --dev --platform desktop",
    "tauri:dev:mobile": "deno run --allow-all scripts/tauri-builder.ts --dev --platform mobile",
    "tauri:dev:webxr": "deno run --allow-all scripts/tauri-builder.ts --dev --platform webxr",
    "tauri:build": "deno run --allow-all scripts/tauri-builder.ts --build --platform desktop --mode production",
    "tauri:build:mobile": "deno run --allow-all scripts/tauri-builder.ts --build --platform mobile --mode production --bundle apk",
    "tauri:build:webxr": "deno run --allow-all scripts/tauri-builder.ts --build --platform webxr --mode production",
    "tauri:build:all": "deno run --allow-all scripts/tauri-builder.ts --build --platform desktop --mode production && deno run --allow-all scripts/tauri-builder.ts --build --platform mobile --mode production && deno run --allow-all scripts/tauri-builder.ts --build --platform webxr --mode production"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.63.2",
    "@clerk/clerk-react": "^5.17.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-three/drei": "^9.95.0",
    "@react-three/fiber": "^8.15.0",
    "@tailwindcss/postcss": "4.0.0",
    "@tanstack/react-form": "^0.34.1",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-router": "^1.120.17",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "@trpc/client": "^10.45.0",
    "@trpc/next": "^10.45.0",
    "@trpc/react-query": "^10.45.0",
    "@trpc/server": "^10.45.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^11.1.0",
    "nx": "^21.2.2",
    "react": "^19.0.0",
    "react-cosmos": "^6.2.0",
    "react-dom": "^19.0.0",
    "superjson": "^2.2.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "three": "^0.160.0",
    "turbo": "^1.10.0",
    "typia": "^6.11.3",
    "zephyr-rspack-plugin": "^0.0.56",
    "zod": "^3.22.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nx/playwright": "^21.2.2",
    "@nx/react": "^21.2.2",
    "@nx/rspack": "^21.2.2",
    "@nx/storybook": "^21.2.2",
    "@playwright/test": "^1.54.0",
    "@rsbuild/core": "^1.0.17",
    "@rsbuild/plugin-react": "^1.0.3",
    "@rsbuild/plugin-svgr": "^1.0.1",
    "@rsbuild/plugin-type-check": "^1.0.1",
    "@rspack/cli": "^1.0.17",
    "@rspack/core": "^1.0.17",
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/react-webpack5": "^9.0.18",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "deno": "^2.1.4",
    "nitropack": "^2.9.7",
    "playwright": "^1.48.2",
    "postcss": "^8.4.49",
    "storybook": "^8.4.7",
    "typescript": "^5.6.3"
  },
  "engines": {
    "deno": ">=2.0.0",
    "node": ">=22.15.0"
  },
  "nx": {
    "includedScripts": []
  }
}
