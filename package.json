{
  "name": "sse-framework",
  "version": "1.0.0",
  "description": "SolidStack Enterprise - A state-of-the-art, cloud-native, distributed system framework",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nx run-many --target=build --all",
    "dev": "nx run-many --target=serve --all --parallel",
    "test": "nx run-many --target=test --all",
    "lint": "nx run-many --target=lint --all",
    "typecheck": "nx run-many --target=typecheck --all",
    "preview": "nx run-many --target=preview --all --parallel",
    "biome": "deno run --allow-read --allow-write npm:@biomejs/biome check .",
    "biome:fix": "deno run --allow-read --allow-write npm:@biomejs/biome check --apply .",

    "dev:marketing": "nx serve marketing",
    "dev:blog": "nx serve blog",
    "dev:docs": "nx serve docs",
    "dev:storefront": "nx serve storefront",
    "dev:remix": "nx serve remix-app",
    "dev:sveltekit": "nx serve sveltekit-spa"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@nx/js": "18.3.0",
    "@nx/rspack": "18.3.0",
    "@rsbuild/core": "^1.0.1",
    "@rsbuild/plugin-solid": "^1.0.1",
    "@rslib/core": "^0.0.5",
    "nx": "18.3.0",
    "@nx/workspace": "18.3.0",
    "@rsbuild/plugin-svelte": "^1.0.1",
    "typescript": "5.6.2"
  },
  "dependencies": {
    "@pandacss/dev": "0.45.2",
    "@tanstack/solid-query": "5.17.1",
    "@tanstack/solid-router": "1.120.17",
    "@types/animejs": "^3.1.12",
    "animejs": "^3.2.2",
    "solid-js": "1.9.7",
    "zustand": "4.4.7"
  },
  "author": "Spectrum Web Co LLC",
  "license": "MIT"
}
