# Katalyst Server - Development Dockerfile
# Optimized for local development with hot reloading and debugging

ARG ELIXIR_VERSION=1.16.0
ARG OTP_VERSION=26.2.1
ARG PYTHON_VERSION=3.12.8
ARG DEBIAN_VERSION=bookworm-20240513-slim

FROM hexpm/elixir:${ELIXIR_VERSION}-erlang-${OTP_VERSION}-debian-${DEBIAN_VERSION} AS dev

# Set development environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV MIX_ENV=dev
ENV RUST_ENV=development
ENV PYTHON_ENV=development
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install comprehensive development dependencies
RUN apt-get update -y && apt-get install -y \
    # Core development tools
    build-essential \
    git \
    curl \
    wget \
    ca-certificates \
    # Python development stack
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3-pip \
    # System libraries
    libffi-dev \
    libssl-dev \
    libbz2-dev \
    libreadline-dev \
    libsqlite3-dev \
    libncurses5-dev \
    libncursesw5-dev \
    xz-utils \
    tk-dev \
    libxml2-dev \
    libxslt1-dev \
    libjpeg-dev \
    libpng-dev \
    # Node.js for assets
    nodejs \
    npm \
    # PostgreSQL client for database
    postgresql-client \
    # Development utilities
    inotify-tools \
    bash \
    htop \
    vim \
    tmux \
    jq \
    # Cleanup
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Install Python 3.12 from source
WORKDIR /tmp
RUN wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tar.xz \
    && tar -xf Python-${PYTHON_VERSION}.tar.xz \
    && cd Python-${PYTHON_VERSION} \
    && ./configure --enable-optimizations --enable-shared --with-lto \
    && make -j$(nproc) \
    && make altinstall \
    && cd / \
    && rm -rf /tmp/Python-${PYTHON_VERSION}*

# Create Python symlinks
RUN ln -sf /usr/local/bin/python3.12 /usr/local/bin/python3 \
    && ln -sf /usr/local/bin/python3.12 /usr/local/bin/python \
    && ln -sf /usr/local/bin/pip3.12 /usr/local/bin/pip3 \
    && ln -sf /usr/local/bin/pip3.12 /usr/local/bin/pip

# Install Rust with development tools
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    --default-toolchain stable \
    --component rustfmt,clippy,rust-analyzer
ENV PATH="/root/.cargo/bin:${PATH}"

# Install wasm-pack for WASM development
RUN cargo install wasm-pack

# Install uv for fast Python package management
RUN pip3 install uv

# Install Deno for advanced JavaScript runtime
RUN curl -fsSL https://deno.land/install.sh | sh
ENV DENO_INSTALL="/root/.deno"
ENV PATH="$DENO_INSTALL/bin:$PATH"

# Set up application directory
WORKDIR /app

# Install Elixir package managers
RUN mix local.hex --force && \
    mix local.rebar --force

# Create Python virtual environment for development
RUN python3 -m venv .venv

# Copy Python requirements and install Claude Code SDK
COPY pyproject.toml python_bridge.py ./
RUN . .venv/bin/activate \
    && uv pip install --upgrade pip setuptools wheel \
    && uv pip install claude-code-sdk>=0.0.19 \
    && uv pip install httpx requests aiohttp \
    && uv pip install ipython jupyter pytest black flake8 \
    && python3 -c "import claude_code_sdk; print('Claude Code SDK installed for development')"

# Copy Elixir dependencies and install
COPY mix.exs mix.lock ./
COPY config config
RUN mix deps.get
RUN mix deps.compile

# Set up Python environment
ENV PYTHONPATH="/app/.venv/lib/python3.12/site-packages"
ENV VIRTUAL_ENV="/app/.venv"
ENV PATH="/app/.venv/bin:$PATH"

# Copy application code
COPY lib lib
COPY priv priv
COPY assets assets
COPY native native

# Install and compile assets
RUN mix assets.setup
RUN mix assets.build

# Compile the application
RUN mix compile

# Build WASM modules if they exist
RUN if [ -d "native/katalyst_wasm" ]; then \
        cd native/katalyst_wasm && \
        wasm-pack build --target deno --out-dir ../../priv/wasm; \
    fi

# Expose development ports
EXPOSE 4000 8080 9091

# Create volumes for development
VOLUME ["/app/lib", "/app/assets", "/app/config", "/app/test"]

# Default command for development with hot reloading
CMD ["mix", "phx.server"]