{
  "name": "types",
  "sourceRoot": "libs/types/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:types"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup src/index.ts --format esm --dts --dts-only",
        "cwd": "libs/types"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup src/index.ts --format esm --dts --dts-only --watch",
        "cwd": "libs/types"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno test src/ --allow-all",
        "cwd": "libs/types"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno lint src/",
        "cwd": "libs/types"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "libs/types"
      }
    }
  }
}