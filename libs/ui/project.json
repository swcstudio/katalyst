{
  "name": "ui",
  "sourceRoot": "libs/ui/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:ui"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup src/index.ts --format esm --dts",
        "cwd": "libs/ui"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsup src/index.ts --format esm --dts --watch",
        "cwd": "libs/ui"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno test src/ --allow-all",
        "cwd": "libs/ui"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno lint src/",
        "cwd": "libs/ui"
      }
    },
    "type-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "libs/ui"
      }
    }
  }
}
