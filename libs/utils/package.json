{
  "name": "@sse/utils",
  "version": "1.0.0",
  "description": "SolidStack Enterprise shared utilities library",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./api": {
      "import": "./dist/api/index.js",
      "types": "./dist/api/index.d.ts"
    },
    "./date": {
      "import": "./dist/date/index.js",
      "types": "./dist/date/index.d.ts"
    },
    "./string": {
      "import": "./dist/string/index.js",
      "types": "./dist/string/index.d.ts"
    },
    "./validation": {
      "import": "./dist/validation/index.js",
      "types": "./dist/validation/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "deno test src/ --allow-all"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "date-fns": "^2.30.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectrum-web-co/sse.git",
    "directory": "libs/utils"
  },
  "keywords": [
    "utilities",
    "helpers",
    "typescript",
    "sse",
    "solidjs"
  ],
  "author": "Spectrum Web Co LLC",
  "license": "MIT"
}
