{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["dom", "dom.iterable", "dom.asynciterable", "deno.ns"]
  },
  "imports": {
    "react": "npm:react@19.1.0",
    "react-dom": "npm:react-dom@19.1.0",
    "@types/react": "npm:@types/react@19.1.6",
    "@types/react-dom": "npm:@types/react-dom@19.1.6",
    "next": "npm:next@15.2.0",
    "@tanstack/react-query": "npm:@tanstack/react-query@5.62.0",
    "@tanstack/react-table": "npm:@tanstack/react-table@8.21.0",
    "@tanstack/react-virtual": "npm:@tanstack/react-virtual@3.11.0",
    "@heroicons/react": "npm:@heroicons/react@2.0.18",
    "payload": "npm:payload@3.50.0",
    "@payloadcms/next": "npm:@payloadcms/next@3.50.0",
    "@payloadcms/db-sqlite": "npm:@payloadcms/db-sqlite@3.50.0",
    "@payloadcms/richtext-lexical": "npm:@payloadcms/richtext-lexical@3.50.0",
    "@next/mdx": "npm:@next/mdx@15.2.0",
    "@mdx-js/react": "npm:@mdx-js/react@3.1.0",
    "@mdx-js/loader": "npm:@mdx-js/loader@3.1.0",
    "sharp": "npm:sharp@0.35.0",
    "framer-motion": "npm:framer-motion@12.27.0",
    "clsx": "npm:clsx@2.2.0",
    "@rsbuild/core": "npm:@rsbuild/core@1.2.0",
    "@rsbuild/plugin-react": "npm:@rsbuild/plugin-react@1.2.0",
    "zustand": "npm:zustand@5.1.0",
    "animejs": "npm:animejs@3.2.2",
    "tailwindcss": "npm:tailwindcss@4.2.0",
    "@tailwindcss/postcss": "npm:@tailwindcss/postcss@4.2.0",
    "tailwindcss-animate": "npm:tailwindcss-animate@1.0.7",
    "autoprefixer": "npm:autoprefixer@10.4.22",
    "@rsbuild/plugin-svgr": "npm:@rsbuild/plugin-svgr@1.2.0",
    "@rsbuild/plugin-type-check": "npm:@rsbuild/plugin-type-check@1.2.0",
    "@biomejs/biome": "npm:@biomejs/biome@1.10.0",
    "@nx/react": "npm:@nx/react@22.0.0",
    "nx": "npm:nx@22.0.0",
    "typescript": "npm:typescript@5.8.0",
    "@swcstudio/shared": "../shared/src/index.ts",
    "@/": "./src/",
    "@payload-config": "./payload.config.ts"
  },
  "tasks": {
    "dev": "deno run --allow-all npm:next dev --port 20009",
    "build": "deno run --allow-all npm:next build",
    "preview": "deno run --allow-all npm:next start --port 20009",
    "payload": "deno run --allow-all npm:payload",
    "payload:migrate": "deno run --allow-all npm:payload migrate",
    "payload:seed": "deno run --allow-all npm:payload seed",
    "payload:generate:types": "deno run --allow-all npm:payload generate:types",
    "test": "deno test --allow-all",
    "lint": "deno run --allow-all npm:@biomejs/biome check .",
    "format": "deno run --allow-all npm:@biomejs/biome format --write .",
    "typecheck": "deno check **/*.ts **/*.tsx"
  }
}
