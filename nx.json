{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.js"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build", "build-native"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "build-native": {
      "inputs": ["default", "{projectRoot}/shared/src/native/**/*"],
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cd shared/src/native && npm run build",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "inputs": ["default", "^production", "{workspaceRoot}/deno.test.config.ts"],
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "deno test --config=deno.test.config.ts",
          "cd shared/src/native && cargo test"
        ],
        "parallel": true
      }
    },
    "test-rust": {
      "inputs": ["default", "{projectRoot}/shared/src/native/**/*"],
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "cd shared/src/native && cargo test",
        "cwd": "{projectRoot}"
      }
    },
    "test-deno": {
      "inputs": ["default", "^production", "{workspaceRoot}/deno.test.config.ts"],
      "cache": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "deno test --config=deno.test.config.ts",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/.eslintrc.json", "{workspaceRoot}/eslint.config.js"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "preview": {
      "cache": false,
      "persistent": true
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "style": "css",
        "linter": "biome",
        "bundler": "rspack",
        "unitTestRunner": "none",
        "e2eTestRunner": "playwright"
      },
      "component": {
        "style": "css"
      },
      "library": {
        "style": "css",
        "linter": "biome",
        "unitTestRunner": "none"
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/rspack/plugin",
      "options": {
        "buildTargetName": "build",
        "devTargetName": "dev",
        "previewTargetName": "preview"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    }
  ]
}
