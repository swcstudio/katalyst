{
  "name": "@katalyst/documentation",
  "version": "1.0.0",
  "description": "Katalyst Framework Documentation - State-of-the-Art GitBook Setup",
  "private": true,
  "scripts": {
    "dev": "gitbook serve",
    "build": "gitbook build",
    "install-gitbook": "gitbook install",
    "pdf": "gitbook pdf . katalyst-documentation.pdf",
    "epub": "gitbook epub . katalyst-documentation.epub",
    "mobi": "gitbook mobi . katalyst-documentation.mobi",
    "serve": "gitbook serve --port 4000",
    "watch": "nodemon --watch src --exec 'npm run build'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "katalyst",
    "documentation",
    "gitbook",
    "typescript",
    "framework"
  ],
  "author": "Katalyst Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "gitbook-cli": "^2.3.2",
    "gitbook-plugin-advanced-emoji": "^0.2.2",
    "gitbook-plugin-anchor-navigation-ex": "^1.0.14",
    "gitbook-plugin-code": "^0.1.0",
    "gitbook-plugin-copy-code-button": "^0.0.2",
    "gitbook-plugin-expandable-chapters": "^0.2.0",
    "gitbook-plugin-github": "^2.0.0",
    "gitbook-plugin-highlight": "^2.0.3",
    "gitbook-plugin-katex": "^1.1.4",
    "gitbook-plugin-mermaid-compat": "^0.1.0",
    "gitbook-plugin-page-toc": "^1.1.1",
    "gitbook-plugin-prism": "^2.4.0",
    "gitbook-plugin-search-pro": "^2.0.2",
    "gitbook-plugin-sharing-plus": "^0.0.2",
    "gitbook-plugin-summary": "^1.0.3",
    "gitbook-plugin-theme-api": "^1.1.2",
    "gitbook-plugin-todo": "^0.1.3",
    "gitbook-plugin-versions-select": "^0.1.1",
    "nodemon": "^3.0.3",
    "typescript": "^5.3.3"
  },
  "gitbook": {
    "gitbook": ">=3.0.0"
  }
}