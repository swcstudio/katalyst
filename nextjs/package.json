{
  "name": "@sse/katalyst-nextjs",
  "version": "0.1.0",
  "description": "Katalyst-React + Next.js Framework - High-performance full-stack framework with Next.js augmentation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "next dev --port 20009",
    "build": "next build",
    "preview": "next start --port 20009",
    "test": "deno test --allow-all",
    "lint": "deno lint",
    "format": "deno fmt",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload",
    "payload:migrate": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload migrate",
    "payload:seed": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload seed",
    "payload:generate:types": "cross-env PAYLOAD_CONFIG_PATH=payload.config.ts payload generate:types"
  },
  "dependencies": {
    "@payloadcms/db-mongodb": "^3.48.0",
    "@payloadcms/db-sqlite": "^3.48.0",
    "@payloadcms/next": "^3.48.0",
    "@payloadcms/richtext-lexical": "^3.48.0",
    "@tanstack/react-form": "^0.34.1",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-router": "^1.120.17",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "animejs": "^3.2.2",
    "graphql": "^16.11.0",
    "next": "^15.1.3",
    "payload": "^3.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
