    "@nx/react": "^21.2.2",
    "@rsbuild/core": "^1.0.17",
    "@rsbuild/plugin-react": "^1.0.3",
    "@rsbuild/plugin-svgr": "^1.0.1",
    "@rsbuild/plugin-type-check": "^1.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.20",
    "nitropack": "^2.9.7",
    "nx": "^21.2.2",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.3"
  }
