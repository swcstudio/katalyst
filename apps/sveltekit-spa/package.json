{
  "name": "sveltekit-spa",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev --port 3005",
    "preview": "rsbuild preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.4",
    "@sveltejs/kit": "^2.5.28",
    "@rsbuild/plugin-svelte": "^1.0.1",
    "svelte": "^4.2.19",
    "svelte-check": "^3.8.6",
    "typescript": "^5.6.2",
    "@rsbuild/core": "^1.0.1",
    "@tanstack/svelte-query": "^5.17.1",
    "@tanstack/svelte-router": "^1.120.17"
  },
  "type": "module"
}
