{
  "tasks": {
    "build": "remix build",
    "dev": "remix dev --port 3004",
    "start": "remix-serve build/index.js",
    "typecheck": "tsc"
  },
  "imports": {
    "@remix-run/node": "npm:@remix-run/node@^2.12.1",
    "@remix-run/react": "npm:@remix-run/react@^2.12.1",
    "@remix-run/serve": "npm:@remix-run/serve@^2.12.1",
    "@remix-run/dev": "npm:@remix-run/dev@^2.12.1",
    "react": "npm:react@^18.3.1",
    "react-dom": "npm:react-dom@^18.3.1",
    "@types/react": "npm:@types/react@^18.3.5",
    "@types/react-dom": "npm:@types/react-dom@^18.3.0",
    "zustand": "npm:zustand@^4.4.7",
    "shared": "../../../libs/shared/index.ts"
  },
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES6"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "target": "ES2022",
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    }
  }
}
