{
  "name": "docs",
  "sourceRoot": "apps/docs/src",
  "projectType": "application",
  "tags": ["scope:docs"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro build",
        "cwd": "apps/docs"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev",
        "cwd": "apps/docs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno test apps/docs/tests"
      }
    }
  }
}
