{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "imports": {
    "react": "npm:react@^19.0.0",
    "react-dom": "npm:react-dom@^19.0.0",
    "@inertiajs/react": "npm:@inertiajs/react@^1.0.0",
    "@adonisjs/core": "npm:@adonisjs/core@^6.0.0",
    "@adonisjs/inertia": "npm:@adonisjs/inertia@^1.0.0",
    "~/shared/": "../../libs/shared/"
  },
  "tasks": {
    "dev": "deno run --allow-all npm:@rsbuild/core dev --port 20007",
    "build": "deno run --allow-all npm:@rsbuild/core build",
    "test": "deno test --allow-all tests/",
    "lint": "deno run --allow-read --allow-write npm:@biomejs/biome check src/"
  }
}
