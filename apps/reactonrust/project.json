{
  "name": "reactonrust",
  "sourceRoot": "apps/reactonrust/src",
  "projectType": "application",
  "tags": ["scope:reactonrust"],
  "targets": {
    "build": {
      "executor": "@rsbuild/core:build",
      "options": {
        "configFile": "apps/reactonrust/rsbuild.config.ts"
      }
    },
    "serve": {
      "executor": "@rsbuild/core:dev",
      "options": {
        "configFile": "apps/reactonrust/rsbuild.config.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno test apps/reactonrust/tests"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno run --allow-read --allow-write npm:@biomejs/biome check apps/reactonrust"
      }
    }
  }
}
