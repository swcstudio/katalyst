{
  "name": "@katalyst/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Katalyst Mobile - React Native cross-platform mobile application",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "build": "expo export:web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "clean": "expo install --fix-broken",
    "postinstall": "expo install --fix"
  },
  "dependencies": {
    "@katalyst/design-system": "workspace:*",
    "@katalyst/shared": "workspace:*",
    "@katalyst/hooks": "workspace:*",
    "@katalyst/api": "workspace:*",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-linking": "~7.0.5",
    "expo-router": "~3.5.23",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "@gluestack-ui/themed": "^2.1.2",
    "@gluestack-ui/config": "^1.2.3",
    "@gluestack-ui/provider": "^0.0.5-alpha.9",
    "react-native-svg": "^15.2.0",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/netinfo": "^11.3.1",
    "@react-native-firebase/app": "^20.5.0",
    "@react-native-firebase/analytics": "^20.5.0",
    "@react-native-firebase/messaging": "^20.5.0",
    "@tanstack/react-query": "^5.59.0",
    "react-native-bootsplash": "^5.5.3",
    "react-native-device-info": "^11.1.1",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.16.1",
    "react-native-haptic-feedback": "^2.3.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-permissions": "^5.4.4",
    "react-native-reanimated": "~3.15.4",
    "react-native-safe-area-context": "^4.10.8",
    "react-native-screens": "^3.31.1",
    "react-native-share": "^11.0.4",
    "react-native-vector-icons": "^10.2.0",
    "react-native-webview": "^13.10.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.73.19",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.3",
    "@react-native/typescript-config": "0.73.1",
    "@rsbuild/core": "^1.0.1",
    "@rsbuild/plugin-react": "^1.0.1",
    "@rsbuild/plugin-svgr": "^1.0.1",
    "@rsbuild/plugin-type-check": "^1.0.1",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.72.8",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.0",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
