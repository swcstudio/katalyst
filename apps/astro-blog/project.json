{
  "name": "astro-blog",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/astro-blog/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno task build",
        "cwd": "apps/astro-blog"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno task dev",
        "cwd": "apps/astro-blog"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno task preview",
        "cwd": "apps/astro-blog"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno task check",
        "cwd": "apps/astro-blog"
      }
    }
  },
  "tags": ["type:app", "framework:astro", "runtime:deno"]
}
