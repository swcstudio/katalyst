{
  "name": "blog",
  "sourceRoot": "apps/blog/src", 
  "projectType": "application",
  "tags": ["scope:blog"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro build",
        "cwd": "apps/blog"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev",
        "cwd": "apps/blog"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "deno test apps/blog/tests"
      }
    }
  }
}
