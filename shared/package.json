{
  "name": "@swcstudio/katalyst-shared",
  "version": "1.0.0",
  "description": "Katalyst Shared Components - Production-ready React framework with multithreading, build tools, and business features",
  "repository": {
    "type": "git",
    "url": "https://github.com/swcstudio/katalyst.git",
    "directory": "shared"
  },
  "license": "Apache-2.0",
  "author": "SomeRandmGuyy",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:clean && npm run build:types && npm run build:bundle",
    "build:clean": "rm -rf dist/",
    "build:types": "deno run --allow-all npm:typescript tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "build:bundle": "deno run --allow-all build.config.ts",
    "format": "deno fmt",
    "lint": "deno lint",
    "test": "deno test --allow-all",
    "prepublishOnly": "npm run build",
    "scraper": "node ./dist/scraper/bin/scraper.js",
    "scraper:dev": "tsx ./src/scraper/bin/scraper.ts"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.63.2",
    "@arco-plugins/unplugin-react": "^1.0.1",
    "@callstack/repack": "^4.3.2",
    "@cosmjs/stargate": "^0.34.0",
    "@midscene/web": "^0.21.3",
    "@module-federation/enhanced": "^0.8.0",
    "@rspack/plugin-react-refresh": "^1.4.3",
    "@tanstack/react-form": "^0.34.1",
    "@tanstack/react-query": "^5.59.20",
    "@tanstack/react-router": "^1.120.17",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.10.8",
    "animejs": "^3.2.2",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0",
    "commander": "^12.0.0",
    "electron-rsbuild": "^0.0.1",
    "@empjs/cli": "^3.9.1-beta.1",
    "@empjs/share": "^3.9.1-beta.1",
    "@empjs/rspack-plugin": "^3.9.1-beta.1",
    "inquirer": "^8.2.6",
    "node-fetch": "^2.7.0",
    "ora": "^5.4.1",
    "pareto": "^0.75.2",
    "react": "^19.0.0",
    "react-cosmos": "^6.2.0",
    "react-dom": "^19.0.0",
    "rspack-manifest-plugin": "^5.0.0",
    "rspack-plugin-virtual-module": "^0.1.13",
    "sails": "^1.5.11",
    "sails-disk": "^2.1.1",
    "sails-mysql": "^1.0.1",
    "sails-postgresql": "^4.0.3",
    "sails-mongo": "^2.1.1",
    "socket.io-client": "^4.7.5",
    "tapable": "^2.2.1",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "typia": "^6.11.3",
    "umi": "^4.3.23",
    "@umijs/max": "^4.3.23",
    "unplugin-stylex": "^0.5.3",
    "zustand": "^5.0.1",
    "@reown/appkit": "^1.0.0",
    "@reown/appkit-adapter-wagmi": "^1.0.0",
    "wagmi": "^2.0.0",
    "viem": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@clerk/clerk-react": "^5.17.0",
    "@nx/react": "^21.2.2",
    "@rsbuild/core": "^1.0.17",
    "@rsbuild/plugin-react": "^1.0.3",
    "@rsbuild/plugin-svgr": "^1.0.1",
    "@rsbuild/plugin-type-check": "^1.0.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/cheerio": "^0.22.35",
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.12.2",
    "@types/node-fetch": "^2.6.11",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@types/turndown": "^5.0.5",
    "@empjs/typescript-plugin-css-modules": "^1.0.0",
    "@rspack/core": "^1.4.10",
    "@rspack/dev-server": "^1.1.3",
    "@rsdoctor/rspack-plugin": "^1.1.8",
    "autoprefixer": "^10.4.20",
    "ngrok": "^5.0.0-beta.2",
    "nitropack": "^2.9.7",
    "nx": "^21.2.2",
    "rsbuild-plugin-react-inspector": "^0.1.2",
    "storybook": "^8.4.7",
    "storybook-builder-rsbuild": "^2.0.2",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.7.0",
    "typescript": "^5.6.3"
  }
}
