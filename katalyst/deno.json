{
  "name": "@katalyst/framework",
  "version": "0.1.0",
  "exports": {
    ".": "./shared/src/index.ts",
    "./core": "./core/src/main.tsx",
    "./remix": "./remix/app/root.tsx", 
    "./nextjs": "./nextjs/src/app/page.tsx",
    "./shared": "./shared/src/index.ts"
  },
  "tasks": {
    "dev": "nx run-many --target=dev --projects=core,remix,nextjs --parallel",
    "dev:core": "deno run --allow-all ../scripts/dev-katalyst-core.ts",
    "dev:remix": "deno run --allow-all ../scripts/dev-katalyst-remix.ts",
    "dev:nextjs": "deno run --allow-all ../scripts/dev-katalyst-nextjs.ts",
    "build": "nx run-many --target=build --projects=core,remix,nextjs --parallel",
    "build:core": "deno run --allow-all ../scripts/build-katalyst-core.ts",
    "build:remix": "deno run --allow-all ../scripts/build-katalyst-remix.ts", 
    "build:nextjs": "deno run --allow-all ../scripts/build-katalyst-nextjs.ts",
    "test": "nx run-many --target=test --projects=core,remix,nextjs,shared --parallel",
    "lint": "nx run-many --target=lint --projects=core,remix,nextjs,shared --parallel",
    "preview": "nx run-many --target=preview --projects=core,remix,nextjs --parallel",
    "preview:core": "deno run --allow-all ../scripts/preview-katalyst-core.ts",
    "preview:remix": "deno run --allow-all ../scripts/preview-katalyst-remix.ts",
    "preview:nextjs": "deno run --allow-all ../scripts/preview-katalyst-nextjs.ts",
    "clean": "nx reset && rm -rf dist .next .remix node_modules/.cache",
    "typecheck": "nx run-many --target=typecheck --projects=core,remix,nextjs,shared --parallel",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "deploy": "nx run-many --target=deploy --projects=core,remix,nextjs --parallel"
  },
  "imports": {
    "@/": "./shared/src/",
    "@shared/": "./shared/src/",
    "@katalyst/shared": "./shared/src/index.ts",
    "@katalyst/core": "./core/src/main.tsx",
    "@katalyst/remix": "./remix/app/root.tsx",
    "@katalyst/nextjs": "./nextjs/src/app/page.tsx",
    "react": "npm:react@^19.0.0",
    "react-dom": "npm:react-dom@^19.0.0",
    "@tanstack/react-router": "npm:@tanstack/react-router@^1.120.17",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.59.20",
    "@tanstack/react-form": "npm:@tanstack/react-form@^0.34.1",
    "@tanstack/react-table": "npm:@tanstack/react-table@^8.20.5",
    "@tanstack/react-virtual": "npm:@tanstack/react-virtual@^3.10.8",
    "zustand": "npm:zustand@^5.0.2",
    "@clerk/clerk-react": "npm:@clerk/clerk-react@^5.17.0",
    "tailwindcss": "npm:tailwindcss@^4.0.0",
    "@arco-design/web-react": "npm:@arco-design/web-react@^2.63.2",
    "react-cosmos": "npm:react-cosmos@^6.2.0",
    "typia": "npm:typia@^6.11.3"
  },
  "compilerOptions": {
    "allowJs": true,
    "lib": ["dom", "dom.iterable", "es6"],
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "unstable": ["sloppy-imports"],
  "nodeModulesDir": "auto",
  "lock": false
}
