{
  "name": "@katalyst/nocode-tui",
  "version": "0.1.0",
  "description": "Beautiful mobile-first terminal UI built with Lynx family framework",
  "private": true,
  "main": "./src/index.tsx",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:ios": "eas build --platform ios",
    "build:android": "eas build --platform android",
    "build:web": "expo export:web",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@katalyst/core": "workspace:*",
    "@katalyst/design-system": "workspace:*",
    "@katalyst/mobile": "workspace:*",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "expo": "^50.0.0",
    "expo-haptics": "^12.8.0",
    "expo-blur": "^12.9.0",
    "expo-linear-gradient": "^12.7.0",
    "expo-status-bar": "^1.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.73.2",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-reanimated": "^3.6.1",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-screens": "^3.29.0",
    "react-native-svg": "^14.1.0",
    "react-native-web": "^0.19.0",
    "zustand": "^4.4.7",
    "valtio": "^1.13.0",
    "jotai": "^2.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@types/react": "^19.0.0",
    "@types/react-native": "^0.72.0",
    "typescript": "^5.3.0"
  },
  "expo": {
    "name": "NoCode TUI",
    "slug": "nocode-tui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.katalyst.nocodetui"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.katalyst.nocodetui"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}