{
  "name": "katalyst-core",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:production": "rsbuild build --config rsbuild.production.config.ts",
    "build:analyze": "BUNDLE_ANALYZE=true npm run build:production",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:ci": "turbo run test --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "setup": "deno task setup",
    "setup:multithreading": "deno run --allow-all ./scripts/setup-multithreading.ts",
    "build:native": "deno run --allow-all ./scripts/build-native.ts",
    "build:native:all": "deno run --allow-all ./scripts/build-native.ts --all",
    "nx": "nx",
    "nx:run": "nx run-many",
    "nx:graph": "nx graph",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "publish:packages": "turbo run build && changeset publish",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.5.0",
    "@rsbuild/core": "^1.0.0",
    "@rsbuild/plugin-react": "^1.0.0",
    "turbo": "^1.12.0",
    "nx": "^18.0.0",
    "@nrwl/workspace": "^18.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@changesets/cli": "^2.26.0",
    "autoprefixer": "^10.4.0",
    "cssnano": "^6.0.0"
  },
  "resolutions": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "deno": ">=1.40.0",
    "bun": ">=1.0.0"
  },
  "packageManager": "deno@1.40.0"
}
